# Audio
ro.audio.monitorRotation=1

# Display
ro.surface_flinger.set_idle_timer_ms=1200

# Radio: T1101-OP is DSDS. The A12 vendor.prop still has stale ss overrides,
# so force the product-level DSDS configuration here.
persist.radio.multisim.config=dsds
persist.vendor.radio.msimmode=dsds
persist.vendor.radio.oem_urc_enable=1
persist.vendor.radio.tsd.multisimmode=1
ro.telephony.sim.count=2
telephony.active_modems.max_count=2
ro.boot.product.hardware.sku=dsds
ro.vendor.radio.max.multisim=dsds

# Tablet / stock T1101-OP product hints.
ro.product.type=tablet
ro.product.wifi_only=0
ro.product.tran.device.name.default=TECNO MEGAPAD 11
