// fstab: install both aliases because the stock DTB reports mt6789 while
// some MediaTek userspace paths still reference mt8781.
prebuilt_etc {
    name: "fstab.mt6789",
    src: "etc/fstab.mt6789",
    vendor: true,
    vendor_ramdisk_available: true,
}

prebuilt_etc {
    name: "fstab.mt8781",
    src: "etc/fstab.mt8781",
    vendor: true,
    vendor_ramdisk_available: true,
}

// Second-stage module loader configuration used by init.mtkgki.rc.
prebuilt_etc {
    name: "init.insmod.mt6789.cfg",
    src: "etc/init.insmod.mt6789.cfg",
    vendor: true,
}
